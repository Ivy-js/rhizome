#!/bin/bash
# Rhizome CLI (home server).
#
#   rhizome status                     tunnel, relay and routes
#   rhizome routes                     published routes: name → user@machine
#   rhizome add <name> <ip> <user>     e.g. rhizome add vm-lucas 192.168.10.2 lucas
#   rhizome remove <name>
#   rhizome publish                    replace all routes with "name ip user" lines read on stdin
#   rhizome configure                  regenerate the tunnel config after editing rhizome.conf
#   rhizome vps [command]              root shell on the VPS
set -euo pipefail

DIR=/etc/rhizome
# shellcheck source=/dev/null
. "$DIR/rhizome.conf"

RE_NAME='^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$'
RE_USER='^[a-z_][a-z0-9_-]{0,31}$'

die() { echo "rhizome: $*" >&2; exit 1; }

# The key is root:rhizome 0640 and ssh refuses a group-readable key to its owner,
# so root goes through the rhizome account.
relay() {
    local -a cmd=(ssh -F "$DIR/ssh_config" -o ClearAllForwardings=yes rhizome-vps "$@")
    if [ "$(id -u)" = 0 ]; then
        runuser -u rhizome -- "${cmd[@]}"
    else
        "${cmd[@]}"
    fi
}

port_of() {
    local ip=$1 n
    [[ $ip == "$NETWORK".* ]] || die "$ip is not in $NETWORK.0/24"
    n=${ip##*.}
    [[ $n =~ ^[0-9]{1,3}$ ]] && ((n >= FIRST && n <= LAST)) || die "$ip is outside $NETWORK.$FIRST-$LAST"
    echo $((PORT_BASE + n))
}

check() {
    [[ $1 =~ $RE_NAME ]] || die "invalid name: $1 (lowercase letters, digits, dashes)"
    [[ $3 =~ $RE_USER ]] || die "invalid user: $3"
}

routes() {
    local name port user
    relay list | while read -r name port user; do
        printf '%-24s → %s@%s\n' "$name" "$user" "$NETWORK.$((port - PORT_BASE))"
    done
}

add() {
    [ $# -eq 3 ] || die "usage: rhizome add <name> <ip> <user>"
    check "$1" "$2" "$3"
    local port
    port=$(port_of "$2")
    relay add "$1" "$port" "$3" >/dev/null
    echo "ssh $1@$DOMAIN → $3@$2"
}

remove() {
    [ $# -eq 1 ] && [[ $1 =~ $RE_NAME ]] || die "usage: rhizome remove <name>"
    relay remove "$1" >/dev/null
    echo "$1 removed"
}

publish() {
    local name ip user extra lines=""
    while read -r name ip user extra || [ -n "${name:-}" ]; do
        [ -n "${name:-}" ] || continue
        [ -z "${extra:-}" ] || die "invalid line: $name $ip $user $extra"
        check "$name" "$ip" "$user"
        lines+="$name $(port_of "$ip") $user"$'\n'
        name=""
    done
    printf '%s' "$lines" | relay replace
}

configure() {
    [ "$(id -u)" = 0 ] || die "must run as root"
    local n
    {
        echo "# Generated by 'rhizome configure' from rhizome.conf"
        echo "Host rhizome-vps"
        echo "    HostName $VPS"
        echo "    Port $ADMIN_PORT"
        echo "    User rhizome"
        echo "    IdentityFile $DIR/key"
        echo "    IdentitiesOnly yes"
        echo "    HostKeyAlias rhizome-vps"
        echo "    UserKnownHostsFile $DIR/known_hosts"
        echo "    GlobalKnownHostsFile /dev/null"
        echo "    StrictHostKeyChecking yes"
        echo "    BatchMode yes"
        echo "    ConnectTimeout 10"
        echo "    ServerAliveInterval 15"
        echo "    ServerAliveCountMax 3"
        echo "    ExitOnForwardFailure yes"
        for n in $(seq "$FIRST" "$LAST"); do
            echo "    RemoteForward 127.0.0.1:$((PORT_BASE + n)) $NETWORK.$n:22"
        done
    } > "$DIR/ssh_config.tmp"
    chmod 0644 "$DIR/ssh_config.tmp"
    mv "$DIR/ssh_config.tmp" "$DIR/ssh_config"
    if systemctl is-enabled --quiet rhizome-tunnel 2>/dev/null; then
        systemctl restart rhizome-tunnel
    fi
}

status() {
    local open expected=$((LAST - FIRST + 1))
    echo "relay       : ssh <name>@$DOMAIN  (VPS $VPS)"
    echo "tunnel      : $(systemctl is-active rhizome-tunnel 2>/dev/null || true)"
    open=$(relay ports | awk -v a=$((PORT_BASE + FIRST)) -v b=$((PORT_BASE + LAST)) '$1 >= a && $1 <= b' | wc -l)
    echo "ports       : $open / $expected open on the VPS"
    echo "fingerprint : $(relay fingerprint | awk '{ print $2 }')"
    echo "routes      : $(relay list | grep -c . || true)"
    routes | sed 's/^/  /'
}

admin() {
    [ "$(id -u)" = 0 ] || die "must run as root"
    exec ssh -p "$ADMIN_PORT" -o HostKeyAlias=rhizome-vps -o UserKnownHostsFile="$DIR/known_hosts" "root@$VPS" "$@"
}

cmd=${1:-status}
shift || true
case "$cmd" in
    status) status ;;
    routes) routes ;;
    add) add "$@" ;;
    remove) remove "$@" ;;
    publish) publish ;;
    configure) configure ;;
    vps) admin "$@" ;;
    *) sed -n '4,10p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
