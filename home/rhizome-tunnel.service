[Unit]
Description=Rhizome reverse SSH tunnel to the relay
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=rhizome
Group=rhizome
ExecStart=/usr/bin/ssh -F /etc/rhizome/ssh_config -N rhizome-vps
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
