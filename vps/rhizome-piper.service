[Unit]
Description=Rhizome public SSH relay (sshpiper)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=rhizome-piper
Group=rhizome-piper
# Each failed login counts twice: 10 = 5 wrong passwords, then a 1 h ban
ExecStart=/usr/local/lib/rhizome/sshpiperd --port 22 \
    --server-key /etc/rhizome/host_key \
    --drop-hostkeys-message \
    /usr/local/lib/rhizome/plugins/yaml --config /var/lib/rhizome/table/pipes.yaml --no-check-perm \
    -- /usr/local/lib/rhizome/plugins/failtoban --max-failures 10 --ban-duration 1h
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
