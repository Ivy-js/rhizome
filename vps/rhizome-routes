#!/bin/sh
# Forced command of the "rhizome" account on the VPS: the home server manages routes through it.
# A route "name port user" sends "ssh name@relay" to user@127.0.0.1:port (a reverse-tunnel port).
set -eu
set -f

ROUTES=/var/lib/rhizome/routes
TABLE=/var/lib/rhizome/table/pipes.yaml

valid() {
    printf '%s\n' "$1" | grep -Eq '^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$' || return 1
    printf '%s\n' "$2" | grep -Eq '^[0-9]{4,5}$' || return 1
    [ "$2" -ge 1024 ] && [ "$2" -le 65535 ] || return 1
    printf '%s\n' "$3" | grep -Eq '^[a-z_][a-z0-9_-]{0,31}$'
}

# Reads routes on stdin, validates all of them, then swaps routes and sshpiper table atomically
write() {
    routes=$(mktemp "$ROUTES.XXXXXX")
    body=$(mktemp)
    seen=" "
    n=0
    while read -r name port user extra || [ -n "${name:-}" ]; do
        [ -n "${name:-}" ] || continue
        if [ -n "${extra:-}" ] || ! valid "$name" "${port:-}" "${user:-}"; then
            rm -f "$routes" "$body"
            echo "invalid route: $name ${port:-} ${user:-}" >&2
            exit 1
        fi
        case "$seen" in *" $name "*)
            rm -f "$routes" "$body"
            echo "duplicate name: $name" >&2
            exit 1 ;;
        esac
        seen="$seen$name "
        n=$((n + 1))
        echo "$name $port $user" >> "$routes"
        printf -- '- from:\n    - username: "%s"\n  to:\n    host: "127.0.0.1:%s"\n    username: "%s"\n' \
            "$name" "$port" "$user" >> "$body"
        name=""
    done
    table=$(mktemp "$(dirname "$TABLE")/.pipes.XXXXXX")
    {
        echo "# Generated by rhizome-routes from $ROUTES"
        echo 'version: "1.0"'
        if [ "$n" -eq 0 ]; then echo "pipes: []"; else echo "pipes:"; cat "$body"; fi
    } > "$table"
    rm -f "$body"
    # setgid directory: the table keeps the group sshpiper reads it with
    chmod 0640 "$table"
    chmod 0644 "$routes"
    mv "$routes" "$ROUTES"
    mv "$table" "$TABLE"
    echo "$n route(s)"
}

[ -f "$ROUTES" ] || : > "$ROUTES"
# shellcheck disable=SC2086
set -- ${SSH_ORIGINAL_COMMAND:-}
case "${1:-}" in
    list)
        cat "$ROUTES" ;;
    add)
        [ $# -eq 4 ] && valid "$2" "$3" "$4" || { echo "usage: add <name> <port> <user>" >&2; exit 1; }
        { grep -v "^$2 " "$ROUTES" || true; echo "$2 $3 $4"; } | write ;;
    remove)
        [ $# -eq 2 ] && valid "$2" 1024 x || { echo "usage: remove <name>" >&2; exit 1; }
        { grep -v "^$2 " "$ROUTES" || true; } | write ;;
    replace)
        write ;;
    ports)
        ss -ltn | awk 'NR > 1 { print $4 }' | sed -n 's/^127\.0\.0\.1://p' | sort -n ;;
    fingerprint)
        ssh-keygen -lf /etc/rhizome/host_key.pub ;;
    *)
        echo "commands: list, add, remove, replace, ports, fingerprint" >&2
        exit 1 ;;
esac
